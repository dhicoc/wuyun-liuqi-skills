{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuyun-liuqi.local/schemas/asset32_yiyan_suibi.schema.json",
  "title": "asset32 — 医验随笔医案库",
  "description": "近代·沈奉江（孟河马培之高足）《医验随笔》蒸馏。沈氏诊断精确、用药工稳，内外兼治：内科善治温病、痰喘、便秘、伏暑，外科善治温毒发痘、疙瘩瘟、痧疹。覆盖高年气虚、实证昏厥、痰火扰神、肝阴不足、疙瘩瘟、伏暑透痦、痰喘、燥结便秘、温毒发痘等。",
  "type": "object",
  "required": [
    "asset_id",
    "asset_name",
    "asset_description",
    "data_source",
    "entry_count",
    "entries"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "const": "asset32_yiyan_suibi"
    },
    "asset_name": {
      "type": "string"
    },
    "asset_description": {
      "type": "string"
    },
    "data_source": {
      "type": "string"
    },
    "distill_method": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "const": "case_library"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 12,
      "maximum": 12
    },
    "total_entries": {
      "type": "integer",
      "minimum": 12,
      "maximum": 12
    },
    "lookup_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "category",
          "physician",
          "chief_complaint",
          "syndrome",
          "treatment",
          "formula",
          "outcome",
          "source",
          "source_quote",
          "entry_id",
          "entry_type"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "description": "医案 ID，如 ysb_001"
          },
          "category": {
            "type": "string",
            "description": "病证分类"
          },
          "physician": {
            "type": "string",
            "description": "医家，如 沈奉江"
          },
          "source": {
            "type": "string",
            "description": "出处"
          },
          "chief_complaint": {
            "type": "string",
            "description": "主诉/病案起由"
          },
          "syndrome": {
            "type": "string",
            "description": "辨证（病机分析）"
          },
          "treatment": {
            "type": "string",
            "description": "治法"
          },
          "formula": {
            "type": "string",
            "description": "方药"
          },
          "outcome": {
            "type": "string",
            "description": "疗效/转归"
          },
          "source_quote": {
            "type": "string",
            "description": "原文逐字摘录"
          },
          "note": {
            "type": "string",
            "description": "辨治要点注释"
          },
          "entry_id": {
            "type": "string",
            "description": "条目 ID"
          },
          "entry_type": {
            "type": "string",
            "const": "yiyan_suibi_case"
          },
          "rag_key": {
            "type": "string",
            "description": "病证检索键"
          },
          "name": {
            "type": "string",
            "description": "可读名"
          }
        }
      }
    }
  }
}