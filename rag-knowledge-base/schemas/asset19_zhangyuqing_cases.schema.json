{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuyun-liuqi.local/schemas/asset19_zhangyuqing_cases.schema.json",
  "title": "asset19 — 张聿青医案库",
  "description": "清·张乃修（张聿青）医案蒸馏。张聿青精于辨证，善治湿温伏暑、痰饮肝风、虚损血证，用药轻灵，注重脾胃气化。覆盖中风、风温、湿温、伏暑、疟、霍乱、咳嗽、吐血、痰饮、肝风、眩晕、脘痛、泄泻、痢、肿胀、风痹、遗精、不寐、调经、产后等病证。",
  "type": "object",
  "required": [
    "asset_id",
    "asset_name",
    "asset_description",
    "data_source",
    "entry_count",
    "entries"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "const": "asset19_zhangyuqing_cases"
    },
    "asset_name": {
      "type": "string"
    },
    "asset_description": {
      "type": "string"
    },
    "data_source": {
      "type": "string"
    },
    "distill_method": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "const": "case_library"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 138,
      "maximum": 138
    },
    "total_entries": {
      "type": "integer",
      "minimum": 138,
      "maximum": 138
    },
    "lookup_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "category",
          "physician",
          "chief_complaint",
          "syndrome",
          "treatment",
          "formula",
          "outcome",
          "source",
          "source_quote",
          "entry_id",
          "entry_type"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "description": "医案 ID，如 zyq_001"
          },
          "category": {
            "type": "string",
            "description": "病证分类，如 中风/湿温/咳嗽等"
          },
          "physician": {
            "type": "string",
            "description": "医家，如 张聿青"
          },
          "source": {
            "type": "string",
            "description": "出处，如 张聿青医案·中风"
          },
          "chief_complaint": {
            "type": "string",
            "description": "主诉/病案起由"
          },
          "syndrome": {
            "type": "string",
            "description": "辨证（病机分析）"
          },
          "treatment": {
            "type": "string",
            "description": "治法"
          },
          "formula": {
            "type": "string",
            "description": "方药"
          },
          "outcome": {
            "type": "string",
            "description": "疗效/转归"
          },
          "source_quote": {
            "type": "string",
            "description": "原文逐字摘录"
          },
          "note": {
            "type": "string",
            "description": "辨治要点注释"
          },
          "entry_id": {
            "type": "string",
            "description": "条目 ID"
          },
          "entry_type": {
            "type": "string",
            "const": "zhangyuqing_case"
          },
          "rag_key": {
            "type": "string",
            "description": "病证检索键"
          },
          "name": {
            "type": "string",
            "description": "可读名"
          }
        }
      }
    }
  }
}