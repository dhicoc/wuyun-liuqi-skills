{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuyun-liuqi.local/schemas/asset23_huayunlou_cases.schema.json",
  "title": "asset23 — 花韵楼医案库",
  "description": "清·顾德华（顾云女士）《花韵楼医案》蒸馏。清代女医妇科名医，专治妇人杂症，辨证透彻、立方平善。以妇科（崩漏、月经不调、产后、胎产、乳癖）为主，兼内科杂病。",
  "type": "object",
  "required": [
    "asset_id",
    "asset_name",
    "asset_description",
    "data_source",
    "entry_count",
    "entries"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "const": "asset23_huayunlou_cases"
    },
    "asset_name": {
      "type": "string"
    },
    "asset_description": {
      "type": "string"
    },
    "data_source": {
      "type": "string"
    },
    "distill_method": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "const": "case_library"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 20,
      "maximum": 20
    },
    "total_entries": {
      "type": "integer",
      "minimum": 20,
      "maximum": 20
    },
    "lookup_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "category",
          "physician",
          "chief_complaint",
          "syndrome",
          "treatment",
          "formula",
          "outcome",
          "source",
          "source_quote",
          "entry_id",
          "entry_type"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "description": "医案 ID，如 hyl_001"
          },
          "category": {
            "type": "string",
            "description": "病证分类"
          },
          "physician": {
            "type": "string",
            "description": "医家，如 顾德华"
          },
          "source": {
            "type": "string",
            "description": "出处"
          },
          "chief_complaint": {
            "type": "string",
            "description": "主诉/病案起由"
          },
          "syndrome": {
            "type": "string",
            "description": "辨证（病机分析）"
          },
          "treatment": {
            "type": "string",
            "description": "治法"
          },
          "formula": {
            "type": "string",
            "description": "方药"
          },
          "outcome": {
            "type": "string",
            "description": "疗效/转归"
          },
          "source_quote": {
            "type": "string",
            "description": "原文逐字摘录"
          },
          "note": {
            "type": "string",
            "description": "辨治要点注释"
          },
          "entry_id": {
            "type": "string",
            "description": "条目 ID"
          },
          "entry_type": {
            "type": "string",
            "const": "huayunlou_case"
          },
          "rag_key": {
            "type": "string",
            "description": "病证检索键"
          },
          "name": {
            "type": "string",
            "description": "可读名"
          }
        }
      }
    }
  }
}